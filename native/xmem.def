LIBRARY xmem
EXPORTS
    XMemAlloc                    = WsxXMemAlloc
    XMemFree                     = WsxXMemFree
    XMemAllocDefault             = WsxXMemAllocDefault
    XMemFreeDefault              = WsxXMemFreeDefault
    XMemSize                     = WsxXMemSize
    XMemSizeDefault              = WsxXMemSizeDefault
    XMemSetAllocationHooks       = WsxXMemSetAllocationHooks
    XMemVirtualQuery             = WsxXMemVirtualQuery
    XMemGetWorkingSetStatistics  = WsxXMemGetWorkingSetStatistics
    XMemProtect                  = WsxXMemProtect
    XMemMapPhysical              = WsxXMemMapPhysical
    XMemUnmapPhysical            = WsxXMemUnmapPhysical
    XMemGetPhysicalAddress       = WsxXMemGetPhysicalAddress
    XMemFlushCache               = WsxXMemFlushCache
    XMemGetAllocationStatistics  = WsxXMemGetAllocationStatistics
    XMemTrimPools                = WsxXMemTrimPools
    XMemGetPoolStatistics        = WsxXMemGetPoolStatistics
    XMemGetWin32HeapStatistics   = WsxXMemGetWin32HeapStatistics
    XMemFreePhysicalPages        = WsxXMemFreePhysicalPages
    XMemTransferMemory           = WsxXMemTransferMemory
    XMemDecodeAttributes         = WsxXMemDecodeAttributes
    XMemRegisterGpuAlias         = WsxXMemRegisterGpuAlias
    XMemUnregisterGpuAlias       = WsxXMemUnregisterGpuAlias
    XMemTranslateTitleGpuVa      = WsxXMemTranslateTitleGpuVa
